# Godot 4+ specific ignores
.godot/
/android/

# The editor's copy of a loaded GDExtension: Windows locks a DLL in use, so
# Godot loads a ~-prefixed copy of it instead. Rewritten every editor launch.
addons/**/~*

# Export output
/build/
/exports/
*.pck
*.zip

# OS / sync junk
desktop.ini
Thumbs.db
.DS_Store
.env

# python bytecode from tools/voice and tools/sfx
__pycache__/
*.pyc
